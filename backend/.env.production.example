# Modèle de configuration pour le serveur de production.
# Sur le serveur : copiez ce fichier en .env, puis remplacez chaque CHANGEZ_MOI.
# Ne mettez JAMAIS le fichier .env sur GitHub.

APP_NAME=IDEE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGEZ_MOI

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base MySQL créée dans Webuzo (Bases de données → MySQL).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGEZ_MOI
DB_USERNAME=CHANGEZ_MOI
DB_PASSWORD=CHANGEZ_MOI

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# E-mails (codes de connexion, confirmation d'adresse) : serveur SMTP de l'hébergeur ou d'un service d'envoi.
MAIL_MAILER=smtp
MAIL_HOST=CHANGEZ_MOI
MAIL_PORT=587
MAIL_USERNAME=CHANGEZ_MOI
MAIL_PASSWORD=CHANGEZ_MOI
MAIL_FROM_ADDRESS=CHANGEZ_MOI
MAIL_FROM_NAME=IDEE

# Adresse du proxy Nginx de Webuzo (le plus souvent 127.0.0.1).
TRUSTED_PROXIES=127.0.0.1

# Envoi des codes de connexion : log | sms | whatsapp | whatsapp_sms
# Tant que les comptes Orange et WhatsApp ne sont pas prêts, gardez « log » :
# les codes sont alors écrits dans storage/logs (aucun vrai membre ne peut se connecter).
IDEE_OTP_DRIVER=log

# API SMS d'Orange Sénégal (developer.orange.com → My apps).
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Numéro d'expéditeur indiqué par Orange, par exemple tel:+2210000
ORANGE_SMS_SENDER=
ORANGE_SMS_SENDER_NAME=

# WhatsApp Business Platform (Meta for Developers → WhatsApp → Configuration de l'API).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CODE_TEMPLATE=idee_code_connexion
WHATSAPP_CODE_LANGUAGE=fr
WHATSAPP_GRAPH_VERSION=v23.0
# Alertes WhatsApp (demandes, rappels) : modèle « utilitaire » avec une variable.
IDEE_WHATSAPP_ALERTS=false
# SMS Orange de secours si une alerte critique (demande de contact, relance) échoue sur WhatsApp.
IDEE_SMS_FALLBACK=false
WHATSAPP_NOTIFICATION_TEMPLATE=idee_alerte

# Assistant IA (business plan) : clé créée sur platform.claude.com, puis IDEE_AI_ENABLED=true.
ANTHROPIC_API_KEY=
IDEE_AI_ENABLED=false

# Notifications push du navigateur : clés créées une fois par « php artisan idee:cles-push ».
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:CHANGEZ_MOI

# Paiements des offres (PA-01) : laissez vide tant que les comptes marchands ne sont pas ouverts.
# Wave Business : clé d'API Checkout, puis IDEE_PAY_WAVE=true.
WAVE_API_KEY=
IDEE_PAY_WAVE=false
# Orange Money : numéro marchand qui reçoit les transferts, vérifiés par l'équipe.
IDEE_ORANGE_MONEY_NUMBER=
# Mentions des reçus et factures (PA-03).
IDEE_COMPANY_NAME=IDEE
IDEE_COMPANY_ADDRESS=
IDEE_COMPANY_NINEA=
IDEE_COMPANY_RCCM=
# Adresse de contact affichée dans les mentions légales et la politique de confidentialité.
IDEE_CONTACT_EMAIL=
# Directeur ou directrice de la publication, et hébergeur du site (nom, adresse).
IDEE_PUBLISHER=
IDEE_HOST=
# Passer à true quand un avocat a validé les textes légaux.
IDEE_LEGAL_VALIDATED=false
