# Copier ce fichier en .env pour le développement local.
APP_ENV=local
APP_URL=http://localhost:8000
IDEE_SERVEUR_ADRESSE=127.0.0.1:8080
RUST_LOG=info

# Base MySQL partagée avec Laravel. Les tests créent leurs propres bases sur ce
# serveur MySQL : l'utilisateur doit pouvoir créer des bases.
DATABASE_URL=mysql://root@127.0.0.1:3306/idee

# Canaux d'envoi des codes : seul « log » (le code va dans le journal) est
# pris en charge pour l'instant.
IDEE_OTP_DRIVER=log
MAIL_MAILER=log

# Relais de développement : les routes pas encore réécrites partent vers
# Laravel (php artisan serve). À laisser vide en production.
IDEE_LARAVEL_URL=http://127.0.0.1:8000
